{
  "expo": {
    "name": "CercaYa",
    "slug": "cercaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.controlapps.cercaya"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FE6F14"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ar.controlapps.cercaya",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CercaYa usa tu ubicación para mostrarte prestadores y pedidos cerca tuyo. Nunca mostramos tu ubicación exacta a otras personas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CercaYa usa tus fotos para que puedas mostrar el problema en un pedido o tus trabajos en tu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FE6F14",
          "defaultChannel": "default"
        }
      ],
      "expo-dev-client"
    ],
    "scheme": "cercaya",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "loctime-devs-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26e9e568-3775-4f20-9fc6-577984766b30"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26e9e568-3775-4f20-9fc6-577984766b30"
    }
  }
}
